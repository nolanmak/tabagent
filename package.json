{
  "name": "tabagent-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/protocol", "packages/bridge", "packages/extension"],
  "scripts": {
    "build": "npm run build -w @tabagent/extension && npm run build -w tabagent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
