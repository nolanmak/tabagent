{
  "name": "tabagent-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/bridge",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build -w @tabagent/extension && npm run build -w tabagent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.0"
  }
}
