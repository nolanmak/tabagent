{
  "name": "tabagent-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/bridge",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build -w @tabagent/extension && npm run build -w tabagent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/gen-docs.mjs --check",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:release": "vitest run --project release",
    "e2e": "playwright test",
    "token-table": "TABAGENT_MANUAL=1 playwright test e2e/manual/token-table.spec.ts",
    "tool-budget": "node scripts/tool-budget.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.0"
  }
}
