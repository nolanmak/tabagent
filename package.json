    "e2e": "playwright test",
    "tool-budget": "node scripts/tool-budget.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
