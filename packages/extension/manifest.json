{
  "manifest_version": 3,
  "name": "TabAgent",
  "version": "0.1.0",
  "description": "Let AI agents (Claude Code, Codex, any MCP client) drive your browser and handle sign-in and 2FA, with permissions you control.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "TabAgent",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "downloads",
    "cookies",
    "alarms",
    "contextMenus",
    "notifications",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "kill-switch": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Stop all agents (kill switch)"
    }
  }
}
